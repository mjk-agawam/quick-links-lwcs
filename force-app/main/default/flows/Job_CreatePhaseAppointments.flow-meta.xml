<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Auto-creates Load-In, one Show Day per calendar day, and Load-Out Service Appointments when a Job is created.</description>
    <label>Job - Create Phase Appointments</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Job__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Get_WorkType_LoadIn</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <!-- ── Get Work Types ── -->
    <recordLookups>
        <name>Get_WorkType_LoadIn</name>
        <label>Get Work Type - Load In</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_WorkType_ShowDay</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>I&amp;D - Booth Installation</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkType</object>
        <outputReference>varWorkType_LoadIn</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <recordLookups>
        <name>Get_WorkType_ShowDay</name>
        <label>Get Work Type - Show Day</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_WorkType_LoadOut</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Advisory Session</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkType</object>
        <outputReference>varWorkType_ShowDay</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <recordLookups>
        <name>Get_WorkType_LoadOut</name>
        <label>Get Work Type - Load Out</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>I&amp;D - Booth Dismantle</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkType</object>
        <outputReference>varWorkType_LoadOut</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <!-- ── Guard: Account must be set ── -->
    <decisions>
        <name>Check_Account</name>
        <label>Account Set?</label>
        <locationX>50</locationX>
        <locationY>420</locationY>
        <defaultConnectorLabel>No Account — skip</defaultConnectorLabel>
        <rules>
            <name>Account_Is_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Phase_Appointments</targetReference>
            </connector>
            <label>Account is set</label>
        </rules>
    </decisions>

    <!-- ── Apex Action: create all SAs ── -->
    <actionCalls>
        <name>Create_Phase_Appointments</name>
        <label>Create Phase Appointments</label>
        <locationX>50</locationX>
        <locationY>540</locationY>
        <actionName>JobPhaseAppointmentCreator</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>jobId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>eventName</name>
            <value>
                <elementReference>$Record.Event_Name__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>startDate</name>
            <value>
                <elementReference>$Record.Event_Start_Date__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>endDate</name>
            <value>
                <elementReference>$Record.Event_End_Date__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>workTypeLoadIn</name>
            <value>
                <elementReference>varWorkType_LoadIn.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>workTypeShowDay</name>
            <value>
                <elementReference>varWorkType_ShowDay.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>workTypeLoadOut</name>
            <value>
                <elementReference>varWorkType_LoadOut.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>accountId</name>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>territoryId</name>
            <value>
                <elementReference>$Record.Service_Territory__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>crewRequiredLoadIn</name>
            <value>
                <elementReference>$Record.Crew_Required_LoadIn__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>crewRequiredShowDay</name>
            <value>
                <elementReference>$Record.Crew_Required_ShowDay__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>crewRequiredLoadOut</name>
            <value>
                <elementReference>$Record.Crew_Required_LoadOut__c</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <!-- ── Variables ── -->
    <variables>
        <name>varWorkType_LoadIn</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkType</objectType>
    </variables>
    <variables>
        <name>varWorkType_ShowDay</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkType</objectType>
    </variables>
    <variables>
        <name>varWorkType_LoadOut</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkType</objectType>
    </variables>
</Flow>
