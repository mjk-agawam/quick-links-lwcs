<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Auto-creates Load-In, Show Day, and Load-Out Service Appointments when a Job is created.</description>
    <label>Job - Create Phase Appointments</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Job__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Get_WorkType_LoadIn</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <!-- ── Get Work Types ── -->
    <recordLookups>
        <name>Get_WorkType_LoadIn</name>
        <label>Get Work Type - Load In</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_WorkType_ShowDay</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>I&amp;D - Booth Installation</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkType</object>
        <outputReference>varWorkType_LoadIn</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <recordLookups>
        <name>Get_WorkType_ShowDay</name>
        <label>Get Work Type - Show Day</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_WorkType_LoadOut</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Advisory Session</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkType</object>
        <outputReference>varWorkType_ShowDay</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <recordLookups>
        <name>Get_WorkType_LoadOut</name>
        <label>Get Work Type - Load Out</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>I&amp;D - Booth Dismantle</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkType</object>
        <outputReference>varWorkType_LoadOut</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <!-- ── Guard: Account must be set ── -->
    <decisions>
        <name>Check_Account</name>
        <label>Account Set?</label>
        <locationX>50</locationX>
        <locationY>420</locationY>
        <defaultConnectorLabel>No Account — skip</defaultConnectorLabel>
        <rules>
            <name>Account_Is_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_LoadIn_SA</targetReference>
            </connector>
            <label>Account is set</label>
        </rules>
    </decisions>

    <!-- ── Create Load-In SA ── -->
    <recordCreates>
        <name>Create_LoadIn_SA</name>
        <label>Create Load-In SA</label>
        <locationX>50</locationX>
        <locationY>560</locationY>
        <connector>
            <targetReference>Create_ShowDay_SA</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>frmSubject_LoadIn</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EarliestStartTime</field>
            <value>
                <elementReference>frmLoadInStart</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DueDate</field>
            <value>
                <elementReference>frmLoadInEnd</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Duration</field>
            <value>
                <numberValue>480.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DurationType</field>
            <value>
                <stringValue>Minutes</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WorkTypeId</field>
            <value>
                <elementReference>varWorkType_LoadIn.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ServiceTerritoryId</field>
            <value>
                <elementReference>$Record.Service_Territory__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentRecordId</field>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>None</stringValue>
            </value>
        </inputAssignments>
        <object>ServiceAppointment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <!-- ── Create Show Day SA ── -->
    <recordCreates>
        <name>Create_ShowDay_SA</name>
        <label>Create Show Day SA</label>
        <locationX>50</locationX>
        <locationY>680</locationY>
        <connector>
            <targetReference>Create_LoadOut_SA</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>frmSubject_ShowDay</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EarliestStartTime</field>
            <value>
                <elementReference>frmShowDayStart</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DueDate</field>
            <value>
                <elementReference>frmShowDayEnd</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Duration</field>
            <value>
                <numberValue>480.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DurationType</field>
            <value>
                <stringValue>Minutes</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WorkTypeId</field>
            <value>
                <elementReference>varWorkType_ShowDay.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ServiceTerritoryId</field>
            <value>
                <elementReference>$Record.Service_Territory__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentRecordId</field>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>None</stringValue>
            </value>
        </inputAssignments>
        <object>ServiceAppointment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <!-- ── Create Load-Out SA ── -->
    <recordCreates>
        <name>Create_LoadOut_SA</name>
        <label>Create Load-Out SA</label>
        <locationX>50</locationX>
        <locationY>800</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>frmSubject_LoadOut</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EarliestStartTime</field>
            <value>
                <elementReference>frmLoadOutStart</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DueDate</field>
            <value>
                <elementReference>frmLoadOutEnd</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Duration</field>
            <value>
                <numberValue>480.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DurationType</field>
            <value>
                <stringValue>Minutes</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WorkTypeId</field>
            <value>
                <elementReference>varWorkType_LoadOut.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ServiceTerritoryId</field>
            <value>
                <elementReference>$Record.Service_Territory__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentRecordId</field>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>None</stringValue>
            </value>
        </inputAssignments>
        <object>ServiceAppointment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <!-- ── Variables ── -->
    <variables>
        <name>varWorkType_LoadIn</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkType</objectType>
    </variables>
    <variables>
        <name>varWorkType_ShowDay</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkType</objectType>
    </variables>
    <variables>
        <name>varWorkType_LoadOut</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkType</objectType>
    </variables>

    <!-- ── Formulas ── -->
    <formulas>
        <name>frmSubject_LoadIn</name>
        <dataType>String</dataType>
        <expression>{!$Record.Event_Name__c} &amp; " - Load-In"</expression>
    </formulas>
    <formulas>
        <name>frmSubject_ShowDay</name>
        <dataType>String</dataType>
        <expression>{!$Record.Event_Name__c} &amp; " - Show Day"</expression>
    </formulas>
    <formulas>
        <name>frmSubject_LoadOut</name>
        <dataType>String</dataType>
        <expression>{!$Record.Event_Name__c} &amp; " - Load-Out"</expression>
    </formulas>
    <formulas>
        <name>frmLoadInStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Event_Start_Date__c}) &amp; " 13:00:00")</expression>
    </formulas>
    <formulas>
        <name>frmLoadInEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Event_Start_Date__c}) &amp; " 21:00:00")</expression>
    </formulas>
    <formulas>
        <name>frmShowDayStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Event_Start_Date__c} + 1) &amp; " 13:00:00")</expression>
    </formulas>
    <formulas>
        <name>frmShowDayEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Event_Start_Date__c} + 1) &amp; " 21:00:00")</expression>
    </formulas>
    <formulas>
        <name>frmLoadOutStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Event_End_Date__c}) &amp; " 13:00:00")</expression>
    </formulas>
    <formulas>
        <name>frmLoadOutEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Event_End_Date__c}) &amp; " 21:00:00")</expression>
    </formulas>
</Flow>
