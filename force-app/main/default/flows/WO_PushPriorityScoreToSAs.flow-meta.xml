        <label>Has SAs?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No SAs — Stop</defaultConnectorLabel>
        <rules>
            <name>Has_SAs_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSAs</leftValueReference>
